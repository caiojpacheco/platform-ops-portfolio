# Normalize line endings to LF in the repository
* text=auto eol=lf

# Force LF for these file types regardless of OS
*.py    text eol=lf
*.tf    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
Dockerfile text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.gif binary
*.ico binary
